# ── Dependencies ────────────────────────────
save-exact=true
engine-strict=true

# ── Security ────────────────────────────────
audit-level=high

# ── Performance ─────────────────────────────
fetch-retries=5
cache=~/.npm-cache
prefer-offline=true

# ── Output ──────────────────────────────────
loglevel=warn
fund=false
